config_version=5
[application]
config/version="0.3.6"
config/name="Terra MX · Dynamics Lab"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/stretch/mode="canvas_items"
[physics]
3d/physics_engine="GodotPhysics3D"
common/physics_ticks_per_second=240
common/max_physics_steps_per_frame=32
3d/default_gravity=9.81
[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.54, 0.68, 0.76, 1)
